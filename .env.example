# Copy to .env and fill in. .env is gitignored; this file is not.
#
# .env is for local development. The deployed build reads .env.production,
# which is committed on purpose - see the Deploying section of the README.
#
# TMDB_API_KEY is here for reference only. It reaches the app through
# `supabase secrets set`, never through a VITE_ variable, or it would ship
# to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
TMDB_API_KEY=