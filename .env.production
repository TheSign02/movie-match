# Build-time values for the deployed app. Committed on purpose.
#
# Both are public by design: the URL is a public endpoint, and the anon
# key is meant to ship to browsers — it identifies the project, it does
# not authorise anything. Row Level Security is the boundary, and
# scripts/verify-privacy.mjs asserts that holds while holding this key.
#
# Vite reads this file for production builds, so the host needs no
# environment variables configured at all. .env (gitignored) still
# covers local development.
#
# Nothing secret belongs here. The TMDB key lives only in the Edge
# Function's environment, and service_role is never used by this app.
VITE_SUPABASE_URL=https://hhxyfthdwahrexpkjojv.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhoeHlmdGhkd2FocmV4cGtqb2p2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MTc0MjEsImV4cCI6MjEwMzM5MzQyMX0.Y2XRqdJMWA8MhY0eRAb47AiEXl03iqEH8x8DzKKRjQ4