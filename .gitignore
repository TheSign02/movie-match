# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.tsbuildinfo

# local env - real credentials, never committed.
#
# .env.production is deliberately NOT ignored and none of the patterns
# below match it. It carries the deployed build's Supabase URL and anon
# key, both of which are public by design, so the host needs no
# environment variables configured. Nothing secret goes in it.
.env
.env.local
.env.*.local
supabase/functions/**/.env

# supabase CLI local state
supabase/.temp/
supabase/.branches/

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-error.log*
